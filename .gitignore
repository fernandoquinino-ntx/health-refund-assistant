# Ignore local PDFs and outputs; only synthetic fixtures are versioned.
data/*
!data/README.md
!data/sinteticos/
data/sinteticos/*
!data/sinteticos/README.md
!data/sinteticos/documentos/
data/sinteticos/documentos/*
!data/sinteticos/documentos/*.pdf
data/sinteticos/resultados/
data/sinteticos/resultados/**

# Documents and model artifacts must not be added, even outside data/.
*.[pP][dD][fF]
*.gguf
*.safetensors
/models/
!/models/README.md
/tools/llama.cpp/

# Private training inputs and derived data.
/data/treinamento/
/data/pdf/
/data/pages/
/data/ocr/
/data/dataset/

# Imported datasets and runtime JSON outputs can contain personal/health data.
json/plan/imports/*.json
json/plan/imports/*.json.tmp
json/documents/state/*.json
json/documents/state/*.json.tmp
json/evaluation/reports/*.json
json/evaluation/reports/*.json.tmp
json/evaluation/reports/*.log
json/reconciliation/reports/*.json
json/reconciliation/reports/*.json.tmp
